const assistants = [
  {number:'01',name:'Film Analyst',role:'The tape room',detail:'Breaks down work into observable moments before anyone offers advice.'},
  {number:'02',name:'Consulting Coach',role:'The game planner',detail:'Reviews discovery, client judgment, problem framing, and engagement decisions.'},
