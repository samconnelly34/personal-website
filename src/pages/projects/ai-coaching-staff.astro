  .project-hero{padding:38px 0 28px}.kicker,.section-label,.figure-label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#607b63;font-weight:700}.project-hero h1{font-size:clamp(32px,5vw,47px);line-height:1.2;margin:11px 0 15px}.project-hero p{max-width:680px;font-size:15px}.project-meta{font-size:12px;color:#777b70;margin-top:12px}
  .project-section{border-top:1px solid #dddcd4;padding:27px 0 28px}.project-section h2{font-size:clamp(19px,3vw,23px);line-height:1.45;margin:8px 0 12px}.project-section p{font-size:14px;max-width:690px}.project-section .lead{font-size:15px;line-height:1.75}.project-section h3{font-size:16px;margin:0 0 7px}
  .visual{margin:18px 0 4px;border:1px solid #deded3;border-radius:5px;background:#f1f1e9;padding:12px;overflow:hidden}.visual img{display:block;width:100%;height:auto;max-width:100%}.visual figcaption{font-size:12px;color:#6d7368;line-height:1.55;padding:10px 3px 1px}
  .playbook{background:#203b2e;border-color:#203b2e;padding:15px}.playbook .figure-label{color:#cad9c4;margin:2px 2px 12px}.playbook img{border-radius:2px}
  .roster-head{background:#e6ece1;border:1px solid #b9c8b7;border-radius:5px;padding:17px 19px;margin:19px 0 10px;display:grid;grid-template-columns:155px 1fr;gap:14px}.roster-head p{margin:0;font-size:13px}.roster-head .number,.coach .number{font-size:11px;color:#5e795f;font-weight:700;letter-spacing:.1em}.roster-head .role,.coach .role{font-size:12px;color:#5f795e;font-weight:700;margin:0 0 8px}
